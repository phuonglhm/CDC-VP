@@ -2035,6 +2035,33 @@ void ISS_CT::exec_steps(const bool debug_single_step) {
 				OP_END();
 
 				OP_CASE(VLUXEI64_V) {
+					/*
+					 * CDC-VP downstream conformance patch (decision record D12).
+					 *
+					 * RVV 1.0 §18.2: "the V extension does not support EEW=64
+					 * for index values when XLEN=32". §7.3: "An implementation
+					 * must raise an illegal instruction exception if the EEW is
+					 * not supported for offset elements."
+					 *
+					 * The rule is about the *index* EEW, so it covers all 32
+					 * encodings that carry one: the four unit forms and the 28
+					 * segment forms `v[sl][ou]xseg[2-8]ei64.v`. Spike applies it
+					 * to all of them through a single `VI_CHECK_ST_INDEX`; here
+					 * each decode site has to say it, so every one of the 32
+					 * carries this check.
+					 *
+					 * This is the RV32 translation unit, so the restriction is
+					 * expressed by refusing the encodings rather than by an XLEN
+					 * test; the RV64 file is untouched and keeps all 32.
+					 *
+					 * Raised *first*, before stats.inc_loadstore() and
+					 * prepInstr(). An illegal instruction must not be counted,
+					 * must not produce bus traffic, and must not set
+					 * mstatus.VS to Dirty -- prepInstr() does the last of those,
+					 * so a check further inside vLoadStore() would already be
+					 * too late.
+					 */
+					RAISE_ILLEGAL_INSTRUCTION();
 					stats.inc_loadstore();
 					v_ext.prepInstr(true, true, false);
 					v_ext.vLoadStore(VExt::load_store_t::load, 64, VExt::load_store_type_t::indexed);
